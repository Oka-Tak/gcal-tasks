# Copy to .env.local and fill in. Never commit the real values.

# --- Google OAuth client (web application) ---
# Authorized redirect URIs to register in Google Cloud:
#   <AUTH_URL>/api/auth/callback/google   (app login)
#   <AUTH_URL>/api/connect/callback        (attaching additional accounts)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Auth.js session ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public base URL. Loopback in dev; the https Tunnel hostname in production.
AUTH_URL=http://localhost:3000

# --- Access control (defence in depth behind Cloudflare Access) ---
# Comma-separated emails allowed to SIGN IN. Empty = allow any Google account.
ALLOWED_EMAILS=

# --- Encryption at rest ---
# Any passphrase; it's hashed to a 32-byte AES-256-GCM key. Used to encrypt the
# Google tokens stored in the SQLite mirror. Generate with: openssl rand -base64 32
KAIROS_ENC_KEY=

# --- Local mirror (SQLite) ---
# Proxmox Claude Code / other tools can read this file directly.
KAIROS_DB=./kairos.db

# --- Local data dir (uploaded screenshots etc.; gitignored, never web-served) ---
KAIROS_DATA=./data

# --- Local CLI agents (life-log extraction & per-task chat) ---
# Binaries must be on PATH (or give absolute paths). claude does vision extraction.
# KAIROS_CLAUDE_BIN=claude
# KAIROS_CODEX_BIN=codex
# Model alias for claude calls (vision-capable). e.g. opus | sonnet | haiku
KAIROS_CLAUDE_MODEL=sonnet
# Hard ceiling per agent invocation, ms.
# KAIROS_AGENT_TIMEOUT_MS=180000

# --- Push notifications via ntfy (optional; unset = off) ---
# Subscribe to the topic in the ntfy app (iOS/Android), then set:
# KAIROS_NTFY_URL=https://ntfy.sh          # or your self-hosted ntfy on Proxmox
# KAIROS_NTFY_TOPIC=                        # long random string — treat as a secret
# KAIROS_NTFY_TOKEN=                        # only for auth-protected self-hosted servers

# --- Embedding (optional) ---
# CSP frame-ancestors for the Proxmox dashboard iframe. Default 'self'.
# FRAME_ANCESTORS='self' https://dash.example.com
