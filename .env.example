# Copy to .env and adjust as needed
PORT=8765
# Secure default is loopback. For LAN/Tailscale access set HOST=0.0.0.0.
HOST=127.0.0.1
# Loopback http for local OAuth. Behind Cloudflare Tunnel use the public https URL
# (and add <BASE_URL>/oauth2callback as an authorized redirect URI in Google Cloud).
BASE_URL=http://localhost:8765
CLIENT_SECRETS=client_secret.json
# Per-account tokens live here (one file per connected Google account).
TOKENS_DIR=tokens
# Optional: only these Cloudflare Access identities may reach the app.
# ALLOWED_EMAILS=you@gmail.com,you@work.com
# Optional: origin allowed to embed this app in an <iframe> (Proxmox dashboard).
# FRAME_ANCESTORS='self' https://dash.example.com
